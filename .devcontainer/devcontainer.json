{
  "name": "Rails Dev Container",
  // 使用する docker-compose.yml のパスを指定
  "dockerComposeFile": "../docker-compose.yml",
  // 開発環境として入るサービス名を指定（yml内の web サービス）
  "service": "web",
  // コンテナ内でプロジェクトがマウントされるディレクトリを指定
  "workspaceFolder": "/app",
  // コンテナ内で自動インストールする VSCode 拡張機能
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "castwide.solargraph",
        "misogi.ruby-rubocop"
      ],
      "settings": {
        "rubyLsp.formatter": "rubocop",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Shopify.ruby-lsp"
      }
    }
  },
  // コンテナ作成後に実行するコマンド（必要に応じて bundle install など）
  "postCreateCommand": "bundle install"
}