# =============================================================================
# 本番環境用環境変数テンプレート (docker-compose.yml)
# 使い方: cp .env.production.example .env.production して値を埋めて使用
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=        # 強固なパスワードを設定すること
POSTGRES_DB=kurahashi_task_production

SECRET_KEY_BASE=          # bundle exec rails secret で生成

TUNNEL_TOKEN=             # Cloudflare Zero Trust > Networks > Tunnels で取得
