<%# 修正ポイント: max-w-7xl を削除し、w-full に変更。mx-auto も不要になります %>
<nav data-controller="navbar" class="strong-bg border-b border-border-strong shadow-sm">
  <div class="w-full px-4 sm:px-8"> 
    <div class="flex justify-start h-16 items-center space-x-8">
      
      <%# ロゴ %>
      <div class="flex-shrink-0">
        <a href="<%= root_path %>" class="text-xl font-bold text-[var(--text-white)] tracking-tight">MyApp</a>
      </div>

      <%# メニュー %>
      <div class="hidden sm:flex sm:items-center sm:space-x-6">
        <%= link_to t("views.daily_planning.index.title"), edit_daily_planning_path, 
            class: "text-sm font-medium text-[var(--text-white)] opacity-80 hover:opacity-100 transition-opacity" %>
        
        <%= link_to t("views.tasks.index.title"), tasks_path, 
            class: "text-sm font-medium text-[var(--text-white)] opacity-80 hover:opacity-100 transition-opacity" %>

        <%= link_to t("views.tasks.new.title"), new_task_path, 
            class: "ml-2 text-sm font-bold px-4 py-1.5 bg-[var(--accent-warm)] text-[var(--text-default)] rounded-md hover:brightness-110 transition-all shadow-sm" %>
      </div>

    </div>
  </div>
</nav>