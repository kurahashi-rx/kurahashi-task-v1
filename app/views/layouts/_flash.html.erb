<% flash.each do |message_type, message| %>
  <div data-controller="flash" class="absolute top-4 right-4 pointer-events-auto animate-in fade-in slide-in-from-top-4 duration-300">
    <%# <div class="bg-blue-600 text-white px-4 py-3 rounded-lg shadow-2xl flex items-center gap-3 animate-in fade-in slide-in-from-top-4 duration-300 pointer-events-auto min-w-[280px] max-w-sm"> %>
    <div class="bg-blue-600 text-white px-4 py-3 rounded-lg shadow-2xl flex items-center gap-3 min-w-[280px]">
      <%# アイコンエリア：flex-shrink-0 でテキストに押されて潰れるのを防ぐ %>
      <div class="flex-shrink-0 flex items-center justify-center bg-white/20 rounded-full p-1">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" style="width: 20px; height: 20px;" class="block">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
      <%# テキストエリア %>
      <div class="flex-1">
        <p class="text-sm font-bold leading-tight">
          <%= message %>
        </p>
      </div>
    </div>
  </div>
<% end %>
