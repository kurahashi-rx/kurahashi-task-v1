<%= form_with(model: task) do |form| %>
  <% if task.errors.any? %>
    <div id="error_explanation" style="background: #fee; color: #c00; padding: 1rem; margin: 1rem 0; border-radius: 4px;">
      <h2><%= t("errors.template.header", count: task.errors.count, model: Task.model_name.human) %></h2>

      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 1rem;">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= form.label :content %>
    <%= form.text_area :content, rows: 4 %>
  </div>

  <div>
    <%= form.submit(task.new_record? ? t("views.tasks.form.submit_create") : t("views.tasks.form.submit_update")) %>
  </div>
<% end %>
