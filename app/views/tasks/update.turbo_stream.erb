<%# 左側リストを更新 %>
<%= turbo_stream.replace dom_id(@task), partial: "tasks/task", locals: { task: @task } %>

<%# 右側詳細パネルを更新 %>
<%= turbo_stream.update "task_detail", partial: "tasks/show_content", locals: { task: @task } %>

<%# フラッシュメッセージを表示 %>
<%= turbo_stream.replace "flash", partial: "layouts/flash" %>