<%# 修正：位置を fixed (固定) にし、高さを 0 にすることで下の要素を押し下げないようにします %>
<div id="flash" class="fixed top-0 left-0 w-full z-[9999] pointer-events-none">
  <%= render "layouts/flash" %>
</div>
<%# 
  [2ペイン・レイアウトのメイン構造] 
  h-[calc(100vh-64px)]: 画面の高さ(100vh)からヘッダー分(64px)を引いたぴったりサイズに固定
  overflow-hidden: 親要素からはみ出た部分を隠し、中身の各ペインで個別にスクロールさせる
%>
<div class="flex h-[calc(100vh-64px)] overflow-hidden">
    <%# 左側：スリムなリストビュー (幅 1/3) %>
  <div class="w-1/3 pane-divider-r bg-[var(--bg-white)] overflow-y-auto">
    
    <%#  sticky top-0: スクロールしても「タイトルと新規作成ボタン」を常に最上部に固定 %>
    <div class="sticky top-0 z-10 bg-[var(--bg-white)] p-4 border-b border-[var(--border-color)]">
      <div class="flex justify-between items-center mb-3">
        <h1 class="text-xl font-bold text-[var(--text-default)] tracking-tight">
          <%= t("views.tasks.index.title") %>
        </h1>
        <%# 新規作成ボタン %>
        <%= link_to "+", new_task_path,
            data: { turbo_frame: "task_detail" },
            class: "inline-flex items-center px-3 py-1 bg-[var(--accent-warm)] text-[var(--text-default)] rounded-md hover:brightness-110 shadow-sm" %>
      </div>

      <%# フィルタフォーム：ステータスを複数選択可能にする %>
      <%= form_with url: tasks_path, method: :get, local: true, class: "mb-3" do %>
        <div class="flex flex-wrap gap-2 items-center">
          <% Task.statuses.keys.each do |s| %>
            <label class="inline-flex items-center space-x-2 text-sm">
              <%# チェックボックス %>
              <%= check_box_tag 'statuses[]', s, (@selected_statuses || []).include?(s), class: "h-4 w-4" %>
              <span><%= I18n.t("activerecord.enums.task.status.#{s}") %></span>
            </label>
          <% end %>
          <div class="ml-2">
            <%= submit_tag t("filter"), class: "inline-flex items-center px-3 py-1 bg-blue-600 text-white rounded-md text-sm" %>
            <%= link_to t("clear"), tasks_path, class: "inline-flex items-center px-3 py-1 ml-2 bg-gray-100 text-sm rounded-md" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# リスト区切り - divide-gray-100 を共通色へ %>
    <div id="tasks_list">
      <%= render @tasks %>
    </div>
  </div>

  <%# 右側：詳細表示パネル (幅 2/3) %>
  <div class="w-2/3 bg-[var(--bg-muted)] overflow-y-auto p-8">
    <%= turbo_frame_tag "task_detail" do %>
    <%# 初期状態（何も選択していない時）のプレースホルダー表示 %>
        <div class="flex flex-col items-center justify-center h-full text-[var(--text-default)] opacity-30">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <p class="text-lg">タスクを選択すると詳細が表示されます</p>
      </div>
    <% end %>
  </div>
</div>