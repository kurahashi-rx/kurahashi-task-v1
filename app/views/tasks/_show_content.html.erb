<%# タスク詳細コンテンツ %>
<div class="max-w-4xl mx-auto space-y-6">
  <%# ヘッダーエリア：タイトルと操作ボタン %>
  <div class="flex flex-col sm:flex-row justify-between items-start border-b border-[var(--border-color)] pb-4 gap-4">
    <div>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-[var(--bg-soft-green)] text-[var(--bg-strong-green)] mb-2">
        <%= task.category %>
      </span>
      <h2 class="text-xl font-bold text-[var(--text-default)] break-words">
        <%= task.title %>
      </h2>
    </div>
    
    <div class="flex gap-2 shrink-0">
      <%= link_to "編集", edit_task_path(task), class: "btn-outline" %>
      <%= button_to "削除", task_path(task), method: :delete, 
          form: { data: { turbo_confirm: "本当に削除しますか？" } }, 
          class: "btn-danger" %>
    </div>
  </div>

  <%# 下部：メタ情報（優先度・ポイントなど） %>
  <div class="flex items-center justify-between pt-6 border-[var(--border-color)] text-xs text-[var(--text-default)] opacity-70">
    <div class="flex gap-8">
      <div>
        <div class="detail-label">優先度</div>
        <span class="font-bold <%= priority_group_text_class(task.priority_group) %>">
          <%= task.priority_group_i18n %>
        </span>
      </div>
      <div>
        <div class="detail-label">ストーリーポイント</div>
        <span class="font-bold text-blue-600"><%= task.story_point_i18n %></span>
      </div>
    </div>
    <div class="text-right">
      <div class="detail-label">作成日時</div>
      <%= l task.created_at, format: :long %>
    </div>
  </div>

  <%# 内容エリア：各セクション %>
  <div class="grid gap-6">
    <% [["目的 / 価値", task.value.presence], ["完了定義 (DOD)", task.definition_of_done.presence ], ["手順", task.procedures.presence]].each do |label, content| %>
      <div class="bg-[var(--bg-white)] p-5 rounded-lg border border-[var(--border-color)] shadow-sm">
        <div class="detail-label"><%= label %></div>
        <div class="text-[var(--text-default)] leading-relaxed">
          <%= content.present? ? content : "未設定" %>
        </div>
      </div>
    <% end %>
  </div>

</div>