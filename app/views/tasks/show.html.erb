<div id="<%= dom_id @task %>">
  <p>
    <strong><%= Task.human_attribute_name(:title) %>:</strong>
    <%= @task.title %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:content) %>:</strong>
    <%= @task.content %>
  </p>
</div>

<div>
  <%= link_to t("views.tasks.show.edit"), edit_task_path(@task) %>
  <%= link_to t("views.tasks.show.back"), tasks_path %>
  <%= button_to t("views.tasks.show.destroy"), @task, method: :delete, data: { turbo_confirm: t("confirm") } %>
</div>
