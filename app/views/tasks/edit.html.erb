<%# タスク編集ビュー %>
<%= turbo_frame_tag "task_detail" do %>
  <div>
    <%#   ヘッダーセクション：タイトル %>
    <h1 class="text-2xl font-medium text-gray-900 tracking-tight mb-8"><%= t("views.tasks.edit.title") %></h1>
    <div class="bg-white rounded-lg shadow-sm px-6 py-6">
      <%= render "form", task: @task %>
    </div>
  </div>
<% end %>