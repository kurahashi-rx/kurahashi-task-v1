<div id="<%= dom_id task %>">
  <p>
    <strong><%= Task.human_attribute_name(:title) %>:</strong>
    <%= task.title %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:content) %>:</strong>
    <%= task.content %>
  </p>

  <p>
    <%= link_to t("views.tasks.task.show"), task %>
    <%= link_to t("views.tasks.task.edit"), edit_task_path(task) %>
    <%= button_to t("views.tasks.task.destroy"), task, method: :delete, data: { turbo_confirm: t("confirm") } %>
  </p>
</div>
