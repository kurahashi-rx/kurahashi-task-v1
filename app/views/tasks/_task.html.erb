<%# [左リスト用のタスク部品] %>
<%# 各タスクを dom_id(task) による一意なIDで囲みます %>
<%= turbo_frame_tag dom_id(task) do %>
  <%= link_to task, data: { turbo_frame: "task_detail" }, class: "block hover:bg-blue-50 transition-colors border-l-4 border-transparent focus:bg-blue-50 focus:border-blue-500" do %>
    <div class="p-4">
      <div class="flex justify-between items-start mb-1">
        <span class="text-xs font-bold <%= priority_text_class(task.priority) %> uppercase tracking-wider">
          <%= task.priority_i18n %>
        </span>
        <span class="text-[10px] px-2 py-0.5 rounded-full <%= status_badge_class(task.status) %>">
          <%= task.status_i18n %>
        </span>
      </div>
      <h3 class="text-sm font-semibold text-gray-900 truncate"><%= task.title %></h3>
      <p class="text-xs text-gray-500 mt-1 truncate"><%= task.content %></p>
    </div>
  <% end %>
<% end %>