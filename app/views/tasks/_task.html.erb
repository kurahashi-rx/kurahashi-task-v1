<div id="<%= dom_id task %>" class="px-6 py-5 hover:bg-gray-50 transition-colors">
  <div class="flex justify-between items-start gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-gray-900 truncate"><%= task.title %></p>
      <% if task.content.present? %>
        <p class="mt-1 text-sm text-gray-500"><%= truncate(task.content, length: 80) %></p>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <%= link_to t("views.tasks.task.show"), task, class: "text-sm text-blue-600 hover:text-blue-700" %>
      <%= link_to t("views.tasks.task.edit"), edit_task_path(task), class: "text-sm text-blue-600 hover:text-blue-700" %>
      <%= button_to t("views.tasks.task.destroy"), task, method: :delete, data: { turbo_confirm: t("confirm") }, form: { class: "inline" }, class: "text-sm text-red-600 hover:text-red-700 bg-transparent border-none cursor-pointer p-0 font-normal" %>
    </div>
  </div>
</div>
