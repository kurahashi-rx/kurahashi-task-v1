<tr id="<%= dom_id task %>" class="hover:bg-gray-50 transition-colors">
  <%# 名称（タイトル） %>
  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
    <%= task.title %>
  </td>

  <%# 内容（コンテント） %>
  <td class="px-6 py-4 text-sm text-gray-500">
    <%= truncate(task.content, length: 50) %>
  </td>

  <%# ステータス（追加したカラム） %>
  <td class="px-6 py-4 whitespace-nowrap text-sm">
    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_badge_class(task.status) %>">
      <%= task.status_i18n %>
    </span>
  </td>

  <%# 操作ボタン %>
  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium flex justify-end gap-3">
    <%= link_to t("views.tasks.task.show"), task, class: "text-blue-600 hover:text-blue-900" %>
    <%= link_to t("views.tasks.task.edit"), edit_task_path(task), class: "text-green-600 hover:text-green-900" %>
    <%= button_to t("views.tasks.task.destroy"), task, method: :delete, 
                  data: { turbo_confirm: t("confirm") }, 
                  class: "text-red-600 hover:text-red-900 bg-transparent border-none cursor-pointer p-0 font-medium" %>
  </td>
</tr>