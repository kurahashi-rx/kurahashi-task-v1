<%# [1行分の部品: _task.html.erb] %>
<tr id="<%= dom_id task %>" class="hover:bg-gray-50 transition-colors border-b border-gray-100">

  <%# 追加：優先度表示 %>
  <td class="px-6 py-4 whitespace-nowrap text-sm">
    <span class="font-bold <%= priority_text_class(task.priority) %>">
      <%= task.priority_i18n %>
    </span>
  </td>

  <%# 名称（タイトル） %>
  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
    <%= task.title %>
  </td>

  <%# 内容（コンテント） %>
  <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
    <%= truncate(task.content, length: 50) %>
  </td>

  <%# ステータス（追加したカラム） %>
  <td class="px-6 py-4 whitespace-nowrap text-sm">
    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_badge_class(task.status) %>">
      <%= task.status_i18n %>
    </span>
  </td>

  <%# 操作ボタン %>
  <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium flex justify-end gap-3">
    <%= link_to t("edit"), edit_task_path(task), class: "text-green-600 hover:text-green-900" %>
    <%= button_to t("destroy"), task, method: :delete, 
                  data: { turbo_confirm: t("confirm") }, 
                  class: "text-red-600 hover:text-red-900 bg-transparent border-none cursor-pointer p-0 font-medium" %>
  </td>
</tr>

